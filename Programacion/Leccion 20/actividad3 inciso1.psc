Algoritmo DiaSemana
		Definir d Como Entero
		
		Escribir "Ingrese un número del 1 al 7:"
		Leer d
		
		Si d = 6 O d = 7 Entonces
			Escribir "Fin de semana"
		SiNo
			Si d >= 1 Y d <= 5 Entonces
				Escribir "Entre semana"
			SiNo
				Escribir "Número inválido"
			FinSi
		FinSi
		
		
FinAlgoritmo
