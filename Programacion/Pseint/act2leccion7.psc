Algoritmo act2leccion7
		Definir op Como Entero
		
		Escribir "1 Ventas"
		Escribir "2 Soporte"
		Escribir "3 Facturacion"
		Escribir "4 Otros"
		Leer op
		
		Si op = 1 Entonces
			Escribir "Ventas"
		SiNo
			Si op = 2 Entonces
				Escribir "Soporte"
			SiNo
				Si op = 3 Entonces
					Escribir "Facturacion"
				SiNo
					Si op = 4 Entonces
						Escribir "Otros"
					SiNo
						Escribir "Opcion invalida"
					FinSi
				FinSi
			FinSi
		FinSi
FinAlgoritmo

	

