Algoritmo DiasDelaSemana
	Definir dia Como Entero
	Escribir "Dime un numero del 1 al 7"
	Leer dia
	Segun dia Hacer
				opcion_1:
					Escribir "Lunes"
				opcion_2:
					Escribir "Martes"
				opcion_3:
					Escribir "Miercoles"
				opcion_4:
					Escribir "Jueves"
				opcion_5:
					Escribir "Viernes"
				opcion_6:
					Escribir "Sabado"
				opcion_7:
					Escribir "Domingo"
				De Otro Modo:
					Escribir "No se puede"
			Fin Segun
	
FinAlgoritmo
