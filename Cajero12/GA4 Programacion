using System;

class CajeroAutomatico
{
    static void Main()
    {
        double saldo = 10000;
        double deposito, retiro;
        int opcion;
        int intentos = 0;
        int pin, pinCorrecto = 1234;

        while (intentos < 3)
        {
            Console.Write("Ingrese su PIN: ");
            pin = int.Parse(Console.ReadLine());

            if (pin == pinCorrecto)
            {
                do
                {
                    Console.WriteLine("\nAcceso Concedido Bienvenido a Banrural");
                    Console.WriteLine("***********************************");
                    Console.WriteLine("* MENU PRINCIPAL");
                    Console.WriteLine("1-- Consultar Saldo");
                    Console.WriteLine("2-- Depositar Dinero");
                    Console.WriteLine("3-- Retirar Dinero");
                    Console.WriteLine("4-- Salir");
                    Console.WriteLine("***********************************");
                    Console.Write("Diga una opcion: ");

                    opcion = int.Parse(Console.ReadLine());

                    switch (opcion)
                    {
                        case 1:
                            Console.WriteLine($"Su saldo actual es: Q {saldo}");
                            break;

                        case 2:
                            Console.Write("Ingrese el monto a depositar: Q ");
                            deposito = double.Parse(Console.ReadLine());
                            saldo += deposito;
                            Console.WriteLine($"Deposito exitoso. Saldo nuevo: Q {saldo}");
                            break;

                        case 3:
                            Console.Write("Ingrese el monto a retirar: Q ");
                            retiro = double.Parse(Console.ReadLine());

                            if (retiro <= saldo)
                            {
                                saldo -= retiro;
                                Console.WriteLine($"Retiro exitoso. Nuevo saldo: Q {saldo}");
                            }
                            else
                            {
                                Console.WriteLine("Fondos insuficientes");
                            }
                            break;

                        case 4:
                            Console.WriteLine("Gracias por usar el cajero 5B");
                            break;

                        default:
                            Console.WriteLine("Opcion inválida");
                            break;
                    }

                } while (opcion != 4);

                intentos = 3; // salir del while
            }
            else
            {
                intentos++;
                Console.WriteLine($"PIN incorrecto, intento {intentos} de 3");
            }
        }

        if (intentos == 3)
        {
            Console.WriteLine("\nTarjeta bloqueada por demasiados intentos fallidos");
        }

        Console.WriteLine("Espere, saliendo del sistema...");
        System.Threading.Thread.Sleep(3000);
    }
}
