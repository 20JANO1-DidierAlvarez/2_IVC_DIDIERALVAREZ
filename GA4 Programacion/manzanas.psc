Algoritmo Inicio
    peso_total = 0
    Mientras peso_total < 1000 Hacer
        Escribir "Coloque una manzana en la báscula (peso en gramos):"
        Leer peso_manzana
        peso_total = peso_total + peso_manzana
        Escribir "Peso actual en la báscula: ", peso_total, " gramos"
    Fin Mientras
    Escribir "Se ha alcanzado o superado el kilo de manzanas."

	
FinAlgoritmo
