Algoritmo Actividad4Inciso1Pág47
    Escribir "Ingrese el número de la tabla que desea ver:"
    Leer tabla
    contador = 1
    Mientras contador <= 10 Hacer
        resultado = tabla * contador
        Escribir tabla, " x ", contador, " = ", resultado
        contador = contador + 1
    Fin Mientras
	
FinAlgoritmo
